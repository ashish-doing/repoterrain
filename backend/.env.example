# RepoTerrain — Environment Variables
# Copy to .env and fill in your values

# ── Google AI ─────────────────────────────────────────────────────────────────
# Used for: Gemini 2.0 Flash (agent) + text-embedding-004 (file embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq (fallback LLM) ───────────────────────────────────────────────────────
# Used when Gemini quota is exceeded — llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here

# ── GitLab ────────────────────────────────────────────────────────────────────
# Personal access token with: api, read_repository, write_repository
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ── GitLab MCP Gateway ────────────────────────────────────────────────────────
# Self-hosted zereight/gitlab-mcp (deploy mcp-gateway/ to Railway)
# See mcp-gateway/README.md for setup steps
# If not set: agent falls back to direct GitLab REST API v4
GITLAB_MCP_GATEWAY_URL=https://repoterrain-mcp-gateway.onrender.com/mcp

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8000
ENV=development